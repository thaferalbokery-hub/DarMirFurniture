@model List<Product>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@AppText.Products (@Model.Count)</h4>
    <a asp-action="Create" class="btn btn-gold"><i class="fas fa-plus ms-1 me-1"></i>إضافة منتج</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الصورة</th>
                    <th>الاسم</th>
                    <th>@AppText.Category</th>
                    <th>@AppText.Brand</th>
                    <th>@AppText.Price</th>
                    <th>المخزون</th>
                    <th>@AppText.Status</th>
                    <th>@AppText.Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            @if (product.ProductImages.Any())
                            {
                                <img src="@product.ProductImages.First().ImageUrl" class="rounded" style="width:50px;height:50px;object-fit:cover;" alt="@product.Name" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                                    <i class="fas fa-image text-muted"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <strong>@product.Name</strong>
                            @if (product.IsFeatured) { <span class="badge bg-warning text-dark ms-1">@AppText.Featured</span> }
                            @if (product.IsNew) { <span class="badge bg-success ms-1">@AppText.New</span> }
                        </td>
                        <td>@product.Category?.Name</td>
                        <td>@product.Brand?.Name</td>
                        <td>
                            @if (product.DiscountPrice.HasValue)
                            {
                                <span class="text-decoration-line-through text-muted price-value">@product.Price.ToYer()</span>
                                <br /><span class="text-danger fw-bold price-value">@product.DiscountPrice.ToYer()</span>
                            }
                            else
                            {
                                <span class="price-value">@product.Price.ToYer()</span>
                            }
                        </td>
                        <td>
                            <span class="numeric-value @(product.StockQuantity <= product.ReorderLevel ? "text-danger fw-bold" : "")">
                                @product.StockQuantity
                            </span>
                        </td>
                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success">@AppText.Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@AppText.Unavailable</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="تعديل"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('@AppText.ConfirmDeleteProduct')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted text-center mb-0">لا توجد منتجات بعد.</p>
        }
    </div>
</div>