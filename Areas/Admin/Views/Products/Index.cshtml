@model List<Product>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Products (@Model.Count)</h4>
    <a asp-action="Create" class="btn btn-gold"><i class="fas fa-plus me-1"></i>Add Product</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            @if (product.ProductImages.Any())
                            {
                                <img src="@product.ProductImages.First().ImageUrl" class="rounded" style="width:50px;height:50px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                                    <i class="fas fa-image text-muted"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <strong>@product.Name</strong>
                            @if (product.IsFeatured) { <span class="badge bg-warning text-dark ms-1">Featured</span> }
                            @if (product.IsNew) { <span class="badge bg-success ms-1">New</span> }
                        </td>
                        <td>@product.Category?.Name</td>
                        <td>@product.Brand?.Name</td>
                        <td>
                            @if (product.DiscountPrice.HasValue)
                            {
                                <span class="text-decoration-line-through text-muted">@product.Price.ToString("N0")</span>
                                <br /><span class="text-danger fw-bold">@product.DiscountPrice.Value.ToString("N0") SAR</span>
                            }
                            else
                            {
                                <span>@product.Price.ToString("N0") SAR</span>
                            }
                        </td>
                        <td>
                            <span class="@(product.StockQuantity <= product.ReorderLevel ? "text-danger fw-bold" : "")">
                                @product.StockQuantity
                            </span>
                        </td>
                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Unavailable</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>