@model ProductReportViewModel

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="text-success">@Model.TotalAvailableProducts</h3>
                <small class="text-muted">Available Products</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="text-danger">@Model.TotalUnavailableProducts</h3>
                <small class="text-muted">Unavailable Products</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">Best Selling Products</h6></div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead><tr><th>Product</th><th class="text-center">Sold</th><th class="text-end">Revenue</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.BestSellingProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td class="text-center">@p.TotalSold</td>
                                <td class="text-end">@p.Revenue.ToString("N0") SAR</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white"><h6 class="mb-0">Popular Categories</h6></div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead><tr><th>Category</th><th class="text-center">Products</th><th class="text-center">Sold</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.PopularCategories)
                        {
                            <tr>
                                <td>@c.CategoryName</td>
                                <td class="text-center">@c.ProductCount</td>
                                <td class="text-center">@c.TotalSold</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0 text-danger">Low Stock Alert</h6></div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead><tr><th>Product</th><th class="text-center">Stock</th><th class="text-center">Reorder</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td class="text-center text-danger fw-bold">@p.CurrentStock</td>
                                <td class="text-center">@p.ReorderLevel</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.LowStockProducts.Any())
                {
                    <p class="text-muted text-center mb-0">All products are well stocked.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Sales" class="btn btn-outline-primary me-2"><i class="fas fa-chart-bar me-1"></i>Sales Report</a>
    <a asp-action="Customers" class="btn btn-outline-primary"><i class="fas fa-users me-1"></i>Customer Report</a>
</div>