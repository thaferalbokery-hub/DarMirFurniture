@model ProductReportViewModel

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="text-success numeric-value">@Model.TotalAvailableProducts</h3>
                <small class="text-muted">منتجات متوفرة</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="text-danger numeric-value">@Model.TotalUnavailableProducts</h3>
                <small class="text-muted">منتجات غير متوفرة</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">المنتجات الأكثر مبيعاً</h6></div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@AppText.Product</th>
                            <th class="text-center">الكمية المباعة</th>
                            <th class="text-end">الإيرادات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.BestSellingProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td class="text-center numeric-value">@p.TotalSold</td>
                                <td class="text-end price-value">@p.Revenue.ToYer()</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.BestSellingProducts.Any())
                {
                    <p class="text-muted text-center mb-0">لا توجد بيانات مبيعات بعد.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white"><h6 class="mb-0">الفئات الأكثر رواجاً</h6></div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@AppText.Category</th>
                            <th class="text-center">عدد المنتجات</th>
                            <th class="text-center">الكمية المباعة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.PopularCategories)
                        {
                            <tr>
                                <td>@c.CategoryName</td>
                                <td class="text-center numeric-value">@c.ProductCount</td>
                                <td class="text-center numeric-value">@c.TotalSold</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.PopularCategories.Any())
                {
                    <p class="text-muted text-center mb-0">لا توجد بيانات بعد.</p>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0 text-danger">تنبيه نقص المخزون</h6></div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@AppText.Product</th>
                            <th class="text-center">المخزون</th>
                            <th class="text-center">حد إعادة الطلب</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td class="text-center text-danger fw-bold numeric-value">@p.CurrentStock</td>
                                <td class="text-center numeric-value">@p.ReorderLevel</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.LowStockProducts.Any())
                {
                    <p class="text-muted text-center mb-0">جميع المنتجات متوفرة بكميات كافية.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Sales" class="btn btn-outline-primary me-2"><i class="fas fa-chart-bar ms-1 me-1"></i>@AppText.SalesReport</a>
    <a asp-action="Customers" class="btn btn-outline-primary"><i class="fas fa-users ms-1 me-1"></i>@AppText.CustomersReport</a>
</div>