@model SalesReportViewModel

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-gold"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Sales" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="text-gold">@Model.TotalSales.ToString("N0") SAR</h3>
                <small class="text-muted">Total Sales</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3>@Model.TotalOrders</h3>
                <small class="text-muted">Total Orders</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3>@Model.AverageOrderValue.ToString("N0") SAR</h3>
                <small class="text-muted">Average Order Value</small>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">Sales by Date</h6></div>
    <div class="card-body">
        <table class="table table-sm">
            <thead><tr><th>Date</th><th>Orders</th><th class="text-end">Sales</th></tr></thead>
            <tbody>
                @foreach (var day in Model.SalesByDate)
                {
                    <tr>
                        <td>@day.Date.ToString("MMM dd, yyyy")</td>
                        <td>@day.OrderCount</td>
                        <td class="text-end">@day.Sales.ToString("N0") SAR</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.SalesByDate.Any())
        {
            <p class="text-muted text-center">No sales data for the selected period.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Products" class="btn btn-outline-primary me-2"><i class="fas fa-box me-1"></i>Product Report</a>
    <a asp-action="Customers" class="btn btn-outline-primary"><i class="fas fa-users me-1"></i>Customer Report</a>
</div>