@model SalesReportViewModel

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">تاريخ البداية</label>
                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" dir="ltr" />
            </div>
            <div class="col-md-4">
                <label class="form-label">تاريخ النهاية</label>
                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" dir="ltr" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-gold"><i class="fas fa-filter ms-1 me-1"></i>تصفية</button>
                <a asp-action="Sales" class="btn btn-outline-secondary">@AppText.Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="text-gold price-value">@Model.TotalSales.ToYer()</h3>
                <small class="text-muted">إجمالي المبيعات</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="numeric-value">@Model.TotalOrders</h3>
                <small class="text-muted">إجمالي الطلبات</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <h3 class="price-value">@Model.AverageOrderValue.ToYer()</h3>
                <small class="text-muted">متوسط قيمة الطلب</small>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">المبيعات حسب التاريخ</h6></div>
    <div class="card-body">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@AppText.Date</th>
                    <th>@AppText.Orders</th>
                    <th class="text-end">المبيعات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Model.SalesByDate)
                {
                    <tr>
                        <td class="numeric-value">@day.Date.ToString(AppText.DateFormat)</td>
                        <td class="numeric-value">@day.OrderCount</td>
                        <td class="text-end price-value">@day.Sales.ToYer()</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.SalesByDate.Any())
        {
            <p class="text-muted text-center mb-0">لا توجد بيانات مبيعات للفترة المحددة.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Products" class="btn btn-outline-primary me-2"><i class="fas fa-box ms-1 me-1"></i>@AppText.ProductsReport</a>
    <a asp-action="Customers" class="btn btn-outline-primary"><i class="fas fa-users ms-1 me-1"></i>@AppText.CustomersReport</a>
</div>