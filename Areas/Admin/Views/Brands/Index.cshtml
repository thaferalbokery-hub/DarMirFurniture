@model List<Brand>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@AppText.Brands (@Model.Count)</h4>
    <a asp-action="Create" class="btn btn-gold"><i class="fas fa-plus ms-1 me-1"></i>إضافة علامة تجارية</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الشعار</th>
                    <th>الاسم</th>
                    <th>الوصف</th>
                    <th>@AppText.Status</th>
                    <th>@AppText.Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var brand in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <img src="@brand.LogoUrl" class="rounded" style="width:40px;height:40px;object-fit:cover;" alt="@brand.Name" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:40px;height:40px;"><i class="fas fa-star text-muted"></i></div>
                            }
                        </td>
                        <td><strong>@brand.Name</strong></td>
                        <td>@(brand.Description?.Length > 40 ? brand.Description[..40] + "..." : brand.Description)</td>
                        <td>
                            <span class="badge @(brand.IsActive ? "bg-success" : "bg-secondary")">@(brand.IsActive ? AppText.Active : AppText.Inactive)</span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@brand.Id" class="btn btn-sm btn-outline-primary" title="تعديل"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@brand.Id" method="post" class="d-inline" onsubmit="return confirm('@AppText.ConfirmDeleteBrand')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted text-center mb-0">لا توجد علامات تجارية بعد.</p>
        }
    </div>
</div>