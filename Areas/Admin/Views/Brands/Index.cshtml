@model List<Brand>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Brands (@Model.Count)</h4>
    <a asp-action="Create" class="btn btn-gold"><i class="fas fa-plus me-1"></i>Add Brand</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr><th>Logo</th><th>Name</th><th>Description</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var brand in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(brand.LogoUrl))
                            {
                                <img src="@brand.LogoUrl" class="rounded" style="width:40px;height:40px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:40px;height:40px;"><i class="fas fa-star text-muted"></i></div>
                            }
                        </td>
                        <td><strong>@brand.Name</strong></td>
                        <td>@(brand.Description?.Length > 40 ? brand.Description[..40] + "..." : brand.Description)</td>
                        <td>
                            <span class="badge @(brand.IsActive ? "bg-success" : "bg-secondary")">@(brand.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@brand.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@brand.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this brand?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>