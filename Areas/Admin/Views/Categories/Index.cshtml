@model List<Category>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@AppText.Categories (@Model.Count)</h4>
    <a asp-action="Create" class="btn btn-gold"><i class="fas fa-plus ms-1 me-1"></i>إضافة فئة</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الصورة</th>
                    <th>الاسم</th>
                    <th>الوصف</th>
                    <th>الترتيب</th>
                    <th>@AppText.Status</th>
                    <th>@AppText.Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(cat.ImageUrl))
                            {
                                <img src="@cat.ImageUrl" class="rounded" style="width:40px;height:40px;object-fit:cover;" alt="@cat.Name" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:40px;height:40px;"><i class="fas fa-tag text-muted"></i></div>
                            }
                        </td>
                        <td><strong>@cat.Name</strong></td>
                        <td>@(cat.Description?.Length > 40 ? cat.Description[..40] + "..." : cat.Description)</td>
                        <td class="numeric-value">@cat.DisplayOrder</td>
                        <td>
                            <span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary")">@(cat.IsActive ? AppText.Active : AppText.Inactive)</span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary" title="تعديل"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('@AppText.ConfirmDeleteCategory')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted text-center mb-0">لا توجد فئات بعد.</p>
        }
    </div>
</div>