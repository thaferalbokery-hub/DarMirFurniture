@model List<Order>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@AppText.Orders (@Model.Count)</h4>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@AppText.OrderNumber</th>
                    <th>@AppText.Customer</th>
                    <th>عدد المنتجات</th>
                    <th>@AppText.Total</th>
                    <th>@AppText.Status</th>
                    <th>@AppText.Date</th>
                    <th>@AppText.Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>@order.OrderNumber</strong></td>
                        <td>@order.FullName<br /><small class="text-muted numeric-value">@order.User?.Email</small></td>
                        <td class="numeric-value">@order.OrderItems.Count</td>
                        <td><strong class="price-value">@order.Total.ToYer()</strong></td>
                        <td><span class="badge @order.Status.BadgeClass()">@order.Status.ToArabic()</span></td>
                        <td class="numeric-value">@order.OrderDate.ToString(AppText.DateFormat)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" title="@AppText.Details"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted text-center mb-0">لا توجد طلبات بعد.</p>
        }
    </div>
</div>