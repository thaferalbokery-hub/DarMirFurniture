<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - @AppText.AdminPanel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-dark text-white">
            <div class="p-3 border-bottom border-secondary">
                <h5 class="mb-0"><i class="fas fa-couch ms-1 me-2 text-gold"></i>@AppText.AdminPanel</h5>
            </div>
            <ul class="nav flex-column p-2">
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-tachometer-alt ms-1 me-2"></i>@AppText.Dashboard</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Products" asp-action="Index"><i class="fas fa-box ms-1 me-2"></i>@AppText.Products</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Categories" asp-action="Index"><i class="fas fa-tags ms-1 me-2"></i>@AppText.Categories</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Brands" asp-action="Index"><i class="fas fa-star ms-1 me-2"></i>@AppText.Brands</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Orders" asp-action="Index"><i class="fas fa-shopping-bag ms-1 me-2"></i>@AppText.Orders</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Reviews" asp-action="Index"><i class="fas fa-star-half-alt ms-1 me-2"></i>@AppText.Reviews</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-controller="Reports" asp-action="Sales"><i class="fas fa-chart-bar ms-1 me-2"></i>@AppText.Reports</a></li>
                <li class="nav-item mt-3 border-top border-secondary pt-3">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-store ms-1 me-2"></i>@AppText.ViewStore</a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="main-content flex-grow-1">
            <nav class="navbar navbar-light bg-white shadow-sm px-4">
                <span class="navbar-text fw-bold">@ViewData["PageTitle"]</span>
                <div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-sign-out-alt ms-1 me-1"></i>@AppText.Logout</button>
                    </form>
                </div>
            </nav>

            <div class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle ms-1 me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fas fa-exclamation-circle ms-1 me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>