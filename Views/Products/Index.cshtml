@model ProductFilterViewModel

<div class="container py-4">
    <nav aria-label="مسار التنقل">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@AppText.Home</a></li>
            <li class="breadcrumb-item active">@AppText.Products</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">تصفية النتائج</h5>
                    <form asp-controller="Products" asp-action="Index" method="get">
                        <div class="mb-3">
                            <label class="form-label fw-bold">@AppText.Search</label>
                            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="ابحث عن منتج..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">@AppText.Category</label>
                            <select name="CategoryId" class="form-select form-select-sm">
                                <option value="">كل الفئات</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">@AppText.Brand</label>
                            <select name="BrandId" class="form-select form-select-sm">
                                <option value="">كل العلامات التجارية</option>
                                @foreach (var brand in Model.Brands)
                                {
                                    <option value="@brand.Id" selected="@(Model.BrandId == brand.Id)">@brand.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">نطاق السعر (ر.ي)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="MinPrice" value="@Model.MinPrice" class="form-control form-control-sm" placeholder="الأدنى" />
                                </div>
                                <div class="col-6">
                                    <input type="number" name="MaxPrice" value="@Model.MaxPrice" class="form-control form-control-sm" placeholder="الأعلى" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الترتيب حسب</label>
                            <select name="SortBy" class="form-select form-select-sm">
                                <option value="newest" selected="@(Model.SortBy == "newest")">الأحدث</option>
                                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">السعر: من الأقل إلى الأعلى</option>
                                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">السعر: من الأعلى إلى الأقل</option>
                                <option value="name" selected="@(Model.SortBy == "name")">الاسم</option>
                                <option value="rating" selected="@(Model.SortBy == "rating")">التقييم</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-gold w-100">تطبيق التصفية</button>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">@AppText.Clear</a>
                    </form>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="mb-0 text-muted">عرض @Model.Products.Count من إجمالي @Model.TotalCount منتج</p>
            </div>

            @if (Model.Products.Any())
            {
                <div class="row">
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-controller="Products" asp-action="Index"
                                       asp-route-Page="@i"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-CategoryId="@Model.CategoryId"
                                       asp-route-BrandId="@Model.BrandId"
                                       asp-route-MinPrice="@Model.MinPrice"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       asp-route-SortBy="@Model.SortBy">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h5>لا توجد منتجات مطابقة</h5>
                    <p class="text-muted">جرّب تعديل خيارات التصفية أو كلمة البحث.</p>
                </div>
            }
        </div>
    </div>
</div>