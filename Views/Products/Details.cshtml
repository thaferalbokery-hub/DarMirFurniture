@model ProductDetailViewModel

<div class="container py-4">
    <nav aria-label="مسار التنقل">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@AppText.Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">@AppText.Products</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Images -->
        <div class="col-md-6 mb-4">
            @if (Model.Images.Any())
            {
                <div class="mb-3">
                    <img src="@Model.Images.First().ImageUrl" class="img-fluid rounded shadow" id="mainImage" alt="@Model.Name" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div class="row g-2">
                        @foreach (var img in Model.Images)
                        {
                            <div class="col-3">
                                <img src="@img.ImageUrl" class="img-fluid rounded thumbnail-img" alt="@(img.AltText ?? Model.Name)" onclick="document.getElementById('mainImage').src='@img.ImageUrl'" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:400px;">
                    <i class="fas fa-couch fa-5x text-muted"></i>
                </div>
            }
        </div>

        <!-- Product Info -->
        <div class="col-md-6">
            <div class="d-flex gap-2 mb-2">
                @if (Model.IsNew) { <span class="badge bg-success">@AppText.New</span> }
                @if (Model.IsFeatured) { <span class="badge bg-warning text-dark">@AppText.Featured</span> }
                @if (!Model.IsAvailable) { <span class="badge bg-danger">@AppText.OutOfStock</span> }
            </div>

            <h2 class="fw-bold">@Model.Name</h2>

            @if (!string.IsNullOrEmpty(Model.BrandName))
            {
                <p class="text-muted mb-2">@AppText.Brand: <strong>@Model.BrandName</strong></p>
            }

            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <p class="text-muted mb-2">@AppText.Category: <strong>@Model.CategoryName</strong></p>
            }

            <!-- Rating -->
            @if (Model.ReviewCount > 0)
            {
                <div class="mb-3">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fas fa-star @(i <= Math.Round(Model.AverageRating) ? "text-gold" : "text-muted")"></i>
                    }
                    <span class="ms-2 text-muted">(@Model.ReviewCount مراجعة)</span>
                </div>
            }

            <!-- Price -->
            <div class="mb-3">
                @if (Model.DiscountPrice.HasValue && Model.DiscountPrice < Model.Price)
                {
                    <h3 class="text-danger fw-bold d-inline price-value">@Model.DiscountPrice.ToYer()</h3>
                    <span class="text-muted text-decoration-line-through ms-2 fs-5 price-value">@Model.Price.ToYer()</span>
                }
                else
                {
                    <h3 class="fw-bold d-inline price-value">@Model.Price.ToYer()</h3>
                }
            </div>

            <p class="mb-3">@Model.Description</p>

            <!-- Details -->
            <div class="card border-0 bg-light mb-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-2">تفاصيل المنتج</h6>
                    <table class="table table-sm table-borderless mb-0">
                        @if (!string.IsNullOrEmpty(Model.Material))
                        {
                            <tr><td class="text-muted">المادة:</td><td>@Model.Material</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.Color))
                        {
                            <tr><td class="text-muted">اللون:</td><td>@Model.Color</td></tr>
                        }
                    </table>
                </div>
            </div>

            <!-- Dimensions -->
            @if (Model.Width.HasValue || Model.Height.HasValue || Model.Depth.HasValue || Model.Weight.HasValue)
            {
                <div class="card border-0 bg-light mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-2">الأبعاد</h6>
                        <div class="row text-center">
                            @if (Model.Width.HasValue) { <div class="col"><small class="text-muted">العرض</small><br /><strong>@Model.Width سم</strong></div> }
                            @if (Model.Height.HasValue) { <div class="col"><small class="text-muted">الارتفاع</small><br /><strong>@Model.Height سم</strong></div> }
                            @if (Model.Depth.HasValue) { <div class="col"><small class="text-muted">العمق</small><br /><strong>@Model.Depth سم</strong></div> }
                            @if (Model.Weight.HasValue) { <div class="col"><small class="text-muted">الوزن</small><br /><strong>@Model.Weight كجم</strong></div> }
                        </div>
                    </div>
                </div>
            }

            <!-- Add to Cart -->
            @if (Model.IsAvailable && Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="d-flex gap-2 align-items-center">
                        <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" class="form-control" style="width:80px;" aria-label="@AppText.Quantity" />
                        <button type="submit" class="btn btn-gold flex-grow-1">
                            <i class="fas fa-cart-plus ms-1 me-2"></i>@AppText.AddToCart
                        </button>
                    </div>
                    <small class="text-muted">المتوفر بالمخزون: @Model.StockQuantity قطعة</small>
                </form>
            }
            else
            {
                <div class="alert alert-warning">هذا المنتج غير متوفر بالمخزون حالياً.</div>
            }
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="mt-5">
        <h4 class="mb-3">مراجعات العملاء (@Model.ReviewCount)</h4>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6>اكتب مراجعتك</h6>
                    <form asp-controller="Products" asp-action="AddReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">التقييم</label>
                            <select name="Rating" class="form-select" required>
                                <option value="">اختر التقييم</option>
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★☆ (4)</option>
                                <option value="3">★★★☆☆ (3)</option>
                                <option value="2">★★☆☆☆ (2)</option>
                                <option value="1">★☆☆☆☆ (1)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">التعليق</label>
                            <textarea name="Comment" class="form-control" rows="3" placeholder="شاركنا تجربتك مع هذا المنتج..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-gold">إرسال المراجعة</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>@review.UserName</strong>
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= review.Rating ? "text-gold" : "text-muted") small"></i>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <small class="text-muted numeric-value">@review.CreatedAt.ToString(AppText.DateFormat)</small>
                                @if (review.IsOwner || User.IsInRole("Admin"))
                                {
                                    <form asp-controller="Products" asp-action="DeleteReview" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reviewId" value="@review.Id" />
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-2" onclick="return confirm('@AppText.ConfirmDeleteReview')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <p class="mt-2 mb-0">@review.Comment</p>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">لا توجد مراجعات بعد. كن أول من يقيّم هذا المنتج!</p>
        }
    </div>
</div>