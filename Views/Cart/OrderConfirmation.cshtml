@model Order

<div class="container py-5">
    <div class="text-center mb-4">
        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
        <h2 class="fw-bold">تم إنشاء طلبك بنجاح!</h2>
        <p class="text-muted">شكراً لثقتك بنا. رقم طلبك هو <strong>@Model.OrderNumber</strong></p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">تفاصيل الطلب</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>@AppText.OrderNumber:</strong> @Model.OrderNumber</p>
                            <p><strong>@AppText.Date:</strong> <span class="numeric-value">@Model.OrderDate.ToString(AppText.DateFormat)</span></p>
                            <p><strong>@AppText.Status:</strong> <span class="badge @Model.Status.BadgeClass()">@Model.Status.ToArabic()</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>الاسم:</strong> @Model.FullName</p>
                            <p><strong>الهاتف:</strong> <span class="numeric-value">@Model.Phone</span></p>
                            <p><strong>المدينة:</strong> @Model.City</p>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2">المنتجات</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>@AppText.Product</th>
                                <th class="text-center">@AppText.Quantity</th>
                                <th class="text-end">@AppText.Price</th>
                                <th class="text-end">@AppText.Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end price-value">@item.UnitPrice.ToYer()</td>
                                    <td class="text-end price-value">@item.Subtotal.ToYer()</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end">@AppText.Subtotal:</td>
                                <td class="text-end price-value">@Model.Subtotal.ToYer()</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end">@AppText.Shipping:</td>
                                <td class="text-end price-value">@CurrencySettings.FormatShipping(Model.ShippingCost)</td>
                            </tr>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">@AppText.Total:</td>
                                <td class="text-end text-gold price-value">@Model.Total.ToYer()</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-dark me-2">
                    <i class="fas fa-box ms-1 me-1"></i>@AppText.MyOrders
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-gold">
                    <i class="fas fa-shopping-bag ms-1 me-1"></i>@AppText.ContinueShopping
                </a>
            </div>
        </div>
    </div>
</div>