@model List<Order>

<div class="container py-4">
    <h3 class="fw-bold mb-4"><i class="fas fa-box ms-1 me-2"></i>@AppText.MyOrders</h3>

    @if (Model.Any())
    {
        @foreach (var order in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <strong>@order.OrderNumber</strong><br />
                            <small class="text-muted numeric-value">@order.OrderDate.ToString(AppText.DateFormat)</small>
                        </div>
                        <div class="col-md-3">
                            <span>@order.OrderItems.Count منتج</span>
                        </div>
                        <div class="col-md-2">
                            <span class="badge @order.Status.BadgeClass()">@order.Status.ToArabic()</span>
                        </div>
                        <div class="col-md-2">
                            <strong class="price-value">@order.Total.ToYer()</strong>
                        </div>
                        <div class="col-md-2 text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye ms-1 me-1"></i>@AppText.Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h4>لا توجد طلبات بعد</h4>
            <p class="text-muted">ابدأ التسوق لإنشاء طلبك الأول.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-gold">@AppText.BrowseProducts</a>
        </div>
    }
</div>