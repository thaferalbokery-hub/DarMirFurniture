@model ProductListItemViewModel

<div class="col-md-4 col-lg-3 mb-4">
    <div class="card border-0 shadow-sm product-card h-100">
        <div class="position-relative">
            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl" class="card-img-top" alt="@Model.Name" style="height: 220px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                    <i class="fas fa-image fa-3x text-muted"></i>
                </div>
            }
            @if (Model.IsNew)
            {
                <span class="badge bg-success position-absolute top-0 start-0 m-2">New</span>
            }
            @if (Model.DiscountPrice.HasValue)
            {
                var discount = (int)Math.Round((1 - (Model.DiscountPrice.Value / Model.Price)) * 100);
                <span class="badge bg-danger position-absolute top-0 end-0 m-2">-@discount%</span>
            }
        </div>
        <div class="card-body d-flex flex-column">
            <h6 class="card-title mb-1">@Model.Name</h6>
            @if (!string.IsNullOrEmpty(Model.BrandName))
            {
                <small class="text-muted">@Model.BrandName</small>
            }
            <div class="mt-auto pt-2">
                @if (Model.DiscountPrice.HasValue)
                {
                    <span class="text-decoration-line-through text-muted me-2">@Model.Price.ToString("N0") SAR</span>
                    <span class="fw-bold text-danger">@Model.DiscountPrice.Value.ToString("N0") SAR</span>
                }
                else
                {
                    <span class="fw-bold">@Model.Price.ToString("N0") SAR</span>
                }
            </div>
            @if (Model.ReviewCount > 0)
            {
                <div class="mt-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= (int)Math.Round(Model.AverageRating))
                        {
                            <i class="fas fa-star text-warning small"></i>
                        }
                        else
                        {
                            <i class="far fa-star text-warning small"></i>
                        }
                    }
                    <small class="text-muted">(@Model.ReviewCount)</small>
                </div>
            }
        </div>
        <div class="card-footer bg-white border-0 pt-0">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-gold btn-sm w-100">
                <i class="fas fa-eye me-1"></i>View Details
            </a>
        </div>
    </div>
</div>