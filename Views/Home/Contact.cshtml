<div class="container py-5">
    <h2 class="fw-bold text-center mb-4">Contact Us</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Get in Touch</h5>
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" placeholder="Your name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="your@email.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text" class="form-control" placeholder="Subject" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="4" placeholder="Your message..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-gold w-100">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Contact Information</h5>
                    <div class="mb-3">
                        <i class="fas fa-map-marker-alt text-gold me-2"></i>
                        <strong>Address:</strong><br />
                        <span class="ms-4">King Fahd Road, Riyadh, Saudi Arabia</span>
                    </div>
                    <div class="mb-3">
                        <i class="fas fa-phone text-gold me-2"></i>
                        <strong>Phone:</strong><br />
                        <span class="ms-4">+966 50 000 0000</span>
                    </div>
                    <div class="mb-3">
                        <i class="fas fa-envelope text-gold me-2"></i>
                        <strong>Email:</strong><br />
                        <span class="ms-4">info@darmir.com</span>
                    </div>
                    <div class="mb-3">
                        <i class="fas fa-clock text-gold me-2"></i>
                        <strong>Working Hours:</strong><br />
                        <span class="ms-4">Sat - Thu: 9:00 AM - 10:00 PM</span><br />
                        <span class="ms-4">Friday: 4:00 PM - 10:00 PM</span>
                    </div>
                    <div class="mt-4">
                        <h6 class="fw-bold">Follow Us</h6>
                        <a href="#" class="btn btn-outline-dark btn-sm me-1"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="btn btn-outline-dark btn-sm me-1"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="btn btn-outline-dark btn-sm me-1"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="btn btn-outline-dark btn-sm"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>