@{
    var featured = ViewData["FeaturedProducts"] as List<ProductListItemViewModel> ?? new();
    var newProducts = ViewData["NewProducts"] as List<ProductListItemViewModel> ?? new();
    var discounted = ViewData["DiscountedProducts"] as List<ProductListItemViewModel> ?? new();
    var categories = ViewData["Categories"] as List<Category> ?? new();
}

<!-- Hero Section -->
<section class="hero-section text-white text-center d-flex align-items-center">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">@AppText.SiteName</h1>
        <p class="lead mb-2">@AppText.SiteTagline</p>
        <p class="mb-4">اجعل مساحتك أكثر أناقة مع مجموعتنا الفاخرة من الأثاث المصنوع بعناية</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-gold btn-lg px-5">
            <i class="fas fa-shopping-bag ms-1 me-2"></i>تسوّق الآن
        </a>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-4 section-title">تسوّق حسب الفئة</h2>
        <div class="row g-3">
            @foreach (var category in categories.Take(8))
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@category.Id" class="text-decoration-none">
                        <div class="card border-0 shadow-sm text-center p-3 category-card">
                            <i class="fas fa-chair fa-2x text-gold mb-2"></i>
                            <h6 class="mb-0">@category.Name</h6>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Products -->
@if (featured.Any())
{
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-4 section-title">أثاث مميز</h2>
            <div class="row">
                @foreach (var product in featured)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

<!-- Discounted Products -->
@if (discounted.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-4 section-title">عروض خاصة</h2>
            <div class="row">
                @foreach (var product in discounted)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

<!-- New Arrivals -->
@if (newProducts.Any())
{
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-4 section-title">وصل حديثاً</h2>
            <div class="row">
                @foreach (var product in newProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
            <div class="text-center mt-3">
                <a asp-controller="Products" asp-action="Index" asp-route-IsNew="true" class="btn btn-outline-dark">عرض كل الوصولات الجديدة</a>
            </div>
        </div>
    </section>
}